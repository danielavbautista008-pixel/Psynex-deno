# Copia este archivo como .env y llena los valores reales.
# El .env NO se sube a git (está en .gitignore).

# --- Servidor ---
PORT=8001
# Origen del frontend Astro (para CORS y para los enlaces de los correos)
FRONTEND_URL=http://localhost:4321

# --- Base de datos (XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psynex

# --- Seguridad ---
# Clave larga y secreta para firmar los tokens de sesión
MY_SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
SERVER=psynex

# --- Correo (nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASSWORD=contraseña-de-aplicacion
