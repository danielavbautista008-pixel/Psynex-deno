#####################################################################
#  PSYNEX - PRUEBAS DE LA API (extensión "REST Client" de VS Code)
#
#  CÓMO USARLO
#  1. Levanta el servidor:  deno task dev   (puerto 8001)
#  2. Escribe tus correos/contraseñas de prueba en las variables de abajo.
#     ¡NO subas a git contraseñas reales! Déjalas vacías antes de hacer commit.
#  3. Ejecuta primero el LOGIN del rol que vas a probar. El servidor guarda
#     el token en la cookie "token" y REST Client la reenvía sola en las
#     siguientes peticiones (ya no hace falta "Authorization: Bearer").
#  4. Para cambiar de rol: ejecuta LOGOUT y luego el login del otro rol.
#  5. Las líneas "# @name xxx" guardan la respuesta para reutilizar IDs:
#     {{xxx.response.body.$.campo}}
#####################################################################

@baseUrl = http://localhost:8001

# --- Credenciales de prueba (rellénalas solo en tu equipo) ---
@adminEmail = admin@ejemplo.com
@adminPassword = CAMBIAR
@psiEmail = psicologo@ejemplo.com
@psiPassword = CAMBIAR
@pacienteEmail = ana.lopez@example.com
@pacientePassword = Password123

# --- IDs de ejemplo de tu base de datos (cámbialos si no existen) ---
@perfilPsicologoId = 4adb5ef8-0368-45c9-a7ab-04c74a66257e
@pacienteId = 707088da-6073-4cc1-879e-50625b6824fc
@citaId = 7c6a66d6-ec6a-4370-b1d9-03e6fe931122
@cuestionarioId = 0385bd92-52ee-4f68-b187-d19da64faa3c
@categoriaId = 1406cc94-14a2-4199-904c-0d0f95bda3e9
@ofertaId = 3252f672-496f-f111-8c20-e86a6456947a
@alertaId = 372ef646-c256-4a0f-95db-581bdfe186fe
@empresaPerfilId = 087218f3-b131-4596-9d84-c5fcb2ff80bf


